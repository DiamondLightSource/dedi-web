    "@mui/x-date-pickers": "^8.0.0",
    "@react-three/fiber": "^8.16.2",
    "mathjs": "^15.0.0",
    "react": "18.3.1",
    "react-color": "^2.19.3",
    "react-dom": "18.3.1",
    "react-error-boundary": "^6.0.0",
    "three": "~0.182.0",
